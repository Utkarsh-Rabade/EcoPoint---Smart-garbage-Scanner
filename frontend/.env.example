# EcoPoints Frontend — Environment Variables
# Copy this file to .env.local and fill in the values from your Supabase dashboard.
# NEXT_PUBLIC_ prefixed vars are safe for the browser.
# NEVER put SUPABASE_SERVICE_ROLE_KEY, SUPABASE_SECRET_KEY, or GEMINI_API_KEY here.

# ── Supabase (browser-safe) ────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ── Application ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
