# EcoPoints Environment Variables Template (backend / scripts — NOT the browser)
# Copy this file to .env.local and fill in the actual values.
# NEVER commit real API keys to version control.
# Edge Function secrets are set with: supabase secrets set NAME=value
# Browser-safe vars live in frontend/.env.local (see frontend/.env.example).

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
# Server-only — bypasses RLS. Never expose via NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Google Gemini AI API (server-only, used by gemini-verify Edge Function)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional shared secret for admin re-trigger of gemini-verify (X-Admin-Secret header).
# Leave empty to disable admin re-trigger.
ADMIN_RETRIGGER_SECRET=

# Local smoke test (node --env-file=.env.local smoke-test.mjs)
SMOKE_TEST_EMAIL=test-user@example.com
SMOKE_TEST_PASSWORD=your_test_password_here

# Optional: External service integrations
# Google Cloud Vision (for future use)
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_api_key_here

# Email service (for notifications)
SMTP_HOST=your_smtp_host_here
SMTP_PORT=your_smtp_port_here
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here
FROM_EMAIL=your_from_email_here

# Feature flags (optional)
ENABLE_IOT_INTEGRATION=false
ENABLE_ANALYTICS=false
ENABLE_EXPERIMENTAL_FEATURES=false

# Application settings
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000

# Rate limiting (requests per minute)
RATE_LIMIT_AUTH=100
RATE_LIMIT_API=50
RATE_LIMIT_SUBMISSIONS=10
RATE_LIMIT_REDEMPTIONS=5

# File upload limits
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Points system settings
POINTS_DAILY_CAP=1000
POINTS_WEEKLY_CAP=4000

# Cache settings (seconds)
CACHE_LEADERBOARD=900  # 15 minutes
CACHE_REWARDS=3600     # 1 hour
CACHE_PROFILE=300      # 5 minutes