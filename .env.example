# EcoPoints Environment Variables Template
# Copy this file to .env and fill in the actual values
# NEVER commit real API keys to version control

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google Gemini AI API
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: External service integrations
# Google Cloud Vision (for future use)
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_api_key_here

# Email service (for notifications)
SMTP_HOST=your_smtp_host_here
SMTP_PORT=your_smtp_port_here
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here
FROM_EMAIL=your_from_email_here

# Feature flags (optional)
ENABLE_IOT_INTEGRATION=false
ENABLE_ANALYTICS=false
ENABLE_EXPERIMENTAL_FEATURES=false

# Application settings
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000

# Rate limiting (requests per minute)
RATE_LIMIT_AUTH=100
RATE_LIMIT_API=50
RATE_LIMIT_SUBMISSIONS=10
RATE_LIMIT_REDEMPTIONS=5

# File upload limits
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Points system settings
POINTS_DAILY_CAP=1000
POINTS_WEEKLY_CAP=4000

# Cache settings (seconds)
CACHE_LEADERBOARD=900  # 15 minutes
CACHE_REWARDS=3600     # 1 hour
CACHE_PROFILE=300      # 5 minutes